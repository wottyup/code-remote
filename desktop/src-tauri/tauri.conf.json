{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Remote",
  "version": "0.115.1-dev.3",
  "identifier": "com.wottyup.coderemote.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["local-shell", "remote-code-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Code Remote desktop client",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi"
      }
    }
  }
}
