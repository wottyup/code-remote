[Unit]
Description=Code Remote tmux session server
After=network.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
RemainAfterExit=yes
ExecStart=/usr/bin/tmux -L code-remote new-session -d -s code-remote-keeper /usr/bin/sleep infinity
ExecStop=-/usr/bin/tmux -L code-remote kill-server
TimeoutStartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
