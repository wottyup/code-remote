[Unit]
Description=DevWisp tmux session server
After=network.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
RemainAfterExit=yes
ExecStart=/usr/bin/tmux -L devwisp new-session -d -s devwisp-keeper /usr/bin/sleep infinity
ExecStop=-/usr/bin/tmux -L devwisp kill-server
TimeoutStartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
