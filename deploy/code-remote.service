[Unit]
Description=Code Remote service
After=network-online.target
After=code-remote-tmux.service
Requires=code-remote-tmux.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/code
EnvironmentFile=-/etc/environment
EnvironmentFile=-/etc/code-remote.env
Environment=HOME=/root
Environment=CODE_REMOTE_WORKSPACE=/code
Environment=PATH=/usr/local/lib/node-v24.19.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/local/bin/node /code/code-remote/node_modules/vite/bin/vite.js build /code/code-remote
ExecStart=/usr/local/bin/node /code/code-remote/scripts/dev.mjs --production
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
